# Thunderbird Bridge connection
# In Docker: use host.docker.internal
# On host: use 127.0.0.1 (default)
TB_BRIDGE_HOST=127.0.0.1
TB_BRIDGE_PORT=7700

# Optional: require a token on every bridge HTTP request.
# Generate one with: openssl rand -hex 32
#
# The SAME value must be set in the bridge daemon's own environment (which is what
# enforces it) and in each client that should be allowed through. Leave it unset to
# run without authentication — an empty value makes the bridge refuse to start rather
# than run unauthenticated by accident.
# TB_AUTH_TOKEN=
